generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  lider
  colaborador
}

enum KpiType {
  numero
  percentual
  moeda
  quantidade
  tempo
  conversao
  media
}

enum Periodicity {
  diaria
  semanal
  mensal
}

enum ProjectStatus {
  no_ritmo
  risco
  atrasado
  pausado
  concluido
}

enum TaskStatus {
  no_ritmo
  atencao
  atrasada
  pausada
  cancelada
  concluida
}

enum TaskPriority {
  baixa
  media
  alta
  urgente
}

enum MuralKind {
  post
  reconhecimento
}

enum EventStatus {
  planejamento
  confirmado
  em_andamento
  realizado
  cancelado
}

enum SponsorStatus {
  negociacao
  assinado
  pago_parcial
  pago_total
  cancelado
}

enum SponsorPaymentPlan {
  avista
  parcelado
}

enum SponsorPaymentMethod {
  pix
  boleto
  pagarme
}

enum SponsorTier {
  gold
  silver
}

enum AttendeeSalePaymentMethod {
  pix
  boleto
  cartao
  outro
}

enum SponsorDealStatus {
  em_negociacao
  assinado
  pago_integralmente
  pago_parcialmente
  pagamento_atrasado
  cancelado
  outro
}

enum EventBudgetCategory {
  press_kit_gold
  press_kit_vip
  a_e_b
  audiovisual
  cenografia
  staff
  reembolsos
  outro
}

enum EventDynamicChoice {
  plano_perfeito
  shark_tank
  outro
}

enum CommsStatus {
  planejado
  enviado
}

enum AttendeeCategory {
  pagante
  convidado_socio
  convidado_patrocinador
  equipe_interna
  socio
  membro_club
  membro_tracao
  equipe_evento
  /// Representante do próprio patrocinador (não confundir com
  /// convidado_patrocinador, que é alguém trazido POR um patrocinador).
  patrocinador
}

enum FinanceCategoryKind {
  receita
  despesa
}

enum PodcastStatus {
  /// Convidado ainda em negociação — antes de virar entrevista_marcada.
  em_conversa
  entrevista_marcada
  entrevista_reagendando
  esperando_material
  material_em_edicao
  episodio_agendado
  episodio_postado
}

enum PodcastSource {
  dom
  karina_social_seller
  carol
  outro
}

enum SocialLeadStatus {
  qualificado
  desqualificado
  reagendando
  sem_resposta
}

enum ContentFormat {
  reels
  stories
  carrossel
  youtube
  post_feed
}

enum ContentPostStatus {
  planejado
  gravado
  editado
  agendado
  publicado
}

enum RhReviewType {
  one_on_one
  trimestral
  anual
}

enum RhClassification {
  projeto_a_validar
  potencial
  performance
  potencial_performance
}

enum CustomerStatus {
  ativo
  em_risco
  pausado
  cancelado
}

enum RenewalStatus {
  disponivel
  renovado
  perdido
  renegociando
}

enum CustomerInteractionKind {
  interacao
  problema
  sucesso
  observacao
}

enum CustomerMeetingType {
  individual
  coletivo
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  title          String
  avatarInitials String
  isGlobalAdmin  Boolean  @default(false)
  createdAt      DateTime @default(now())

  memberships          Membership[]
  ledKpis              Kpi[]                 @relation("KpiResponsible")
  kpiEntries           KpiEntry[]
  ownedProjects        Project[]             @relation("ProjectOwner")
  assignedTasks        Task[]                @relation("TaskAssignee")
  assignedSubtasks     TaskSubtask[]         @relation("TaskSubtaskAssignee")
  taskComments         TaskComment[]         @relation("TaskCommentAuthor")
  libraryAdded         LibraryItem[]         @relation("LibraryAddedBy")
  libraryAuthored      LibraryItem[]         @relation("LibraryAuthor")
  muralPosts           MuralPost[]
  muralReactions       MuralReaction[]
  muralComments        MuralComment[]
  notifications        Notification[]
  auditEntries         AuditLog[]
  responsibleEvents    Event[]               @relation("EventResponsible")
  eventNotes           EventNote[]           @relation("EventNoteAuthor")
  payables             Payable[]             @relation("PayableResponsible")
  receivables          Receivable[]          @relation("ReceivableResponsible")
  rhReviewsReceived    RhReview[]            @relation("RhReviewSubject")
  rhReviewsGiven       RhReview[]            @relation("RhReviewEvaluator")
  salaryRecord         SalaryRecord?
  trainingRsvps        TrainingAttendee[]
  socialProfiles       SocialProfile[]
  socialLeads          SocialSellingLead[]
  contentPosts         ContentCalendarPost[]
  csCustomers          Customer[]            @relation("CustomerCS")
  customerInteractions CustomerInteraction[] @relation("CustomerInteractionAuthor")
  customerFollowUps    CustomerExperience[]  @relation("ExperienceFollowUpOwner")
  customerMeetings     CustomerMeeting[]     @relation("CustomerMeetingAuthor")
  csActions            CsAction[]            @relation("CsActionAuthor")
  sponsorsCreated      Sponsor[]             @relation("SponsorCreatedBy")
  sponsorInteractions  SponsorInteraction[]  @relation("SponsorInteractionAuthor")
  attendeeSales        EventAttendeeSale[]
  socialProfileReports SocialProfileReport[]
  podcastRecordingFor  PodcastEpisode[]      @relation("PodcastRecordingResponsible")
  podcastMaterialFor   PodcastEpisode[]      @relation("PodcastMaterialResponsible")
  podcastPostFor       PodcastEpisode[]      @relation("PodcastPostResponsible")
  podcastDispatchFor   PodcastEpisode[]      @relation("PodcastDispatchResponsible")
  leadsAssigned        Lead[]                @relation("LeadAssignee")
  leadInteractions     LeadInteraction[]     @relation("LeadInteractionAuthor")
  mediaDeliverablesTracking EventMediaDeliverable[] @relation("MediaDeliverableTrackingOwner")
  mediaDeliverablesExecuting EventMediaDeliverable[] @relation("MediaDeliverableExecutionOwner")
  attendeeNegotiations EventAttendeeNegotiation[] @relation("EventAttendeeNegotiationSeller")
}

model Area {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  order       Int    @default(0)

  memberships Membership[]
  kpis        Kpi[]
  projects    Project[]
  tasks       Task[]
}

model Membership {
  id     String         @id @default(cuid())
  userId String
  areaId String
  role   MembershipRole
  title  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
}

model Kpi {
  id             String      @id @default(cuid())
  areaId         String
  name           String
  description    String
  type           KpiType
  unit           String
  periodicity    Periodicity
  target         Float?
  cumulative     Boolean     @default(false)
  higherIsBetter Boolean     @default(true)
  responsibleId  String
  createdAt      DateTime    @default(now())

  area        Area        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  responsible User        @relation("KpiResponsible", fields: [responsibleId], references: [id])
  entries     KpiEntry[]
  targets     KpiTarget[]
}

/// Per-period override of a KPI's target (e.g. a monthly revenue goal that
/// changes every month) — falls back to Kpi.target when no row matches.
model KpiTarget {
  id        String @id @default(cuid())
  kpiId     String
  /// "YYYY-MM" for a monthly KPI, "YYYY" for an annual one
  periodKey String
  target    Float

  kpi Kpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, periodKey])
}

model KpiEntry {
  id          String   @id @default(cuid())
  kpiId       String
  value       Float
  date        DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  kpi       Kpi  @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([kpiId, date])
}

model Project {
  id          String        @id @default(cuid())
  areaId      String
  name        String
  description String
  ownerId     String
  startDate   DateTime
  deadline    DateTime
  status      ProjectStatus @default(no_ritmo)
  progressPct Int           @default(0)
  /// Tipo de iniciativa — texto livre (ver PROJECT_KINDS em
  /// src/lib/projects.ts): Projeto, Evento, Lançamento, Coquetel, Aula,
  /// Webinar, Hot Seat, Outro.
  kind        String        @default("Projeto")
  /// Link opcional pro Evento real (Eventos), quando o projeto é a
  /// coordenação cross-área de um evento específico.
  eventId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  area  Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  owner User   @relation("ProjectOwner", fields: [ownerId], references: [id])
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  tasks Task[]
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  product       String?
  areaId        String
  projectId     String?
  assigneeId    String
  deadline      DateTime
  status        TaskStatus   @default(no_ritmo)
  priority      TaskPriority @default(media)
  note          String?
  /// Marcado quando o status vira "concluida" — base para calcular
  /// pontualidade de entregas automaticamente (completedAt <= deadline).
  completedAt   DateTime?
  /// Cliente relacionado (CS) — opcional, só preenchido quando a tarefa é
  /// sobre um mentorado específico.
  customerId    String?
  /// Texto livre ("semanal", "mensal"...) ou null para tarefa avulsa.
  recurrence    String?
  /// Post do calendário de Social que originou esta tarefa (card estilo
  /// Asana) — opcional, só preenchido para tarefas abertas por lá.
  contentPostId String?
  /// Patrocinador relacionado (Patrocínios) — opcional, mesmo padrão do
  /// customerId acima, pra tarefas específicas de um patrocinador.
  sponsorId     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  area        Area                 @relation(fields: [areaId], references: [id], onDelete: Cascade)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee    User                 @relation("TaskAssignee", fields: [assigneeId], references: [id])
  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contentPost ContentCalendarPost? @relation(fields: [contentPostId], references: [id], onDelete: SetNull)
  sponsor     Sponsor?             @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  checklist   TaskChecklistItem[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  /// Subtarefas — mesmo conjunto de campos da tarefa principal (título,
  /// responsável, prazo, prioridade, anexos), pra dividir entre pessoas
  /// diferentes sem virar uma segunda Task de verdade no Workflow.
  subtasks    TaskSubtask[]

  @@index([contentPostId])
  @@index([sponsorId])
}

/// Link ou arquivo anexado a uma tarefa — pode ter mais de um. `kind`
/// distingue link de referência (briefing, drive...) de arquivo de entrega
/// (o resultado final do trabalho) — mesmo texto livre usado em vez de enum
/// pra não travar categorias futuras numa migration.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  url       String
  kind      String   @default("referencia")
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Subtarefa de uma Task — não aparece no Workflow/Kanban geral (só dentro do
/// card da tarefa principal), mas carrega o mesmo conjunto de campos porque
/// pode ser de um colaborador diferente do responsável pela tarefa-mãe.
model TaskSubtask {
  id          String       @id @default(cuid())
  taskId      String
  title       String
  assigneeId  String
  priority    TaskPriority @default(media)
  status      TaskStatus   @default(no_ritmo)
  deadline    DateTime
  completedAt DateTime?
  note        String?
  createdAt   DateTime     @default(now())

  task        Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee    User                    @relation("TaskSubtaskAssignee", fields: [assigneeId], references: [id])
  attachments TaskSubtaskAttachment[]

  @@index([taskId])
}

model TaskSubtaskAttachment {
  id        String   @id @default(cuid())
  subtaskId String
  label     String
  url       String
  kind      String   @default("referencia")
  createdAt DateTime @default(now())

  subtask TaskSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@index([subtaskId])
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("TaskCommentAuthor", fields: [authorId], references: [id])
}

model LibraryItem {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String
  category    String
  tags        String
  url         String
  authorLabel String
  authorId    String?
  addedById   String
  createdAt   DateTime @default(now())

  author  User? @relation("LibraryAuthor", fields: [authorId], references: [id])
  addedBy User  @relation("LibraryAddedBy", fields: [addedById], references: [id])
}

model MuralPost {
  id        String    @id @default(cuid())
  authorId  String
  content   String
  imageUrl  String?
  linkUrl   String?
  kind      MuralKind @default(post)
  createdAt DateTime  @default(now())

  author    User            @relation(fields: [authorId], references: [id])
  reactions MuralReaction[]
  comments  MuralComment[]
}

model MuralReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String   @default("👏")
  createdAt DateTime @default(now())

  post MuralPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model MuralComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   MuralPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Eventos (Igor): imersões, summits, experiences e jantares — cada evento
// carrega seu próprio orçamento, patrocínios, lista de confirmados e mural.
// ---------------------------------------------------------------------------

model Event {
  id              String      @id @default(cuid())
  name            String
  type            String
  status          EventStatus @default(planejamento)
  startDate       DateTime
  endDate         DateTime
  location        String?
  description     String?
  budgetPlanned   Float?
  /// Não é mais preenchido diretamente — a meta de patrocínio exibida é
  /// sempre calculada como budgetPlanned * 1.5 na camada de exibição.
  /// Coluna mantida por segurança (não removida), mas não gravada mais.
  sponsorshipGoal Float?
  responsibleId   String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  /// Local do evento.
  venueAddress String?
  venueCost    Float?
  venueNotes   String?

  /// Planilha de respostas de NPS enviada (upload) + comentários livres
  /// extraídos dela para exibição — ver src/lib/nps-excel.ts.
  npsExcelUrl      String?
  npsExcelComments String?

  /// Links de eNPS diário — 3 dias por evento.
  enpsDay1Url String?
  enpsDay2Url String?
  enpsDay3Url String?

  /// Estatísticas agregadas de eventos já realizados, quando só o resumo
  /// histórico está disponível (sem lista nominal de confirmados). Eventos
  /// novos devem preferir EventAttendee/Sponsor, que dão o mesmo total
  /// automaticamente — estes campos existem para não perder o histórico real.
  registrationGoal Int?
  registeredCount  Int?
  presentCount     Int?
  payingCount      Int?
  mentoradosCount  Int?
  guestCount       Int?
  noShowCount      Int?
  sponsorCount     Int?
  npsResponses     Int?
  npsAverage       Float?

  responsible    User                 @relation("EventResponsible", fields: [responsibleId], references: [id])
  days           EventDay[]
  budgetLines    EventBudgetLine[]
  /// Legado — patrocinador cadastrado direto no evento. Descontinuado: novos
  /// patrocinadores só nascem em Patrocínios (ver model Sponsor). Mantido
  /// sem uso ativo para não perder histórico já gravado.
  legacySponsors EventSponsor[]
  sponsors       Sponsor[]
  attendees      EventAttendee[]
  notes          EventNote[]
  cashMovements  CashMovement[]
  experiences    CustomerExperience[]
  sponsorships   Sponsorship[]
  dinnerGuests    EventDinnerGuest[]
  commsItems      EventCommsItem[]
  mediaDeliverables EventMediaDeliverable[]
  commercialProducts EventCommercialProduct[]
  debriefReports  EventDebriefReport[]
  linkedProjects  Project[]
}

model EventDay {
  id        String   @id @default(cuid())
  eventId   String
  date      DateTime
  startTime String?
  endTime   String?

  event  Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agenda EventAgendaItem[]

  @@unique([eventId, date])
}

/// Reestruturado (era só time+description) pra "Ordem do dia" — nunca tinha
/// uso real em src/, então a reestruturação não perde dado nenhum.
model EventAgendaItem {
  id         String  @id @default(cuid())
  eventDayId String
  title      String // O que
  who        String? // Quem
  startTime  String? // Horário de início
  endTime    String? // Horário de término
  objective  String? // Objetivo
  notes      String? // Observação
  order      Int     @default(0)

  eventDay EventDay @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
}

model EventBudgetLine {
  id              String              @id @default(cuid())
  eventId         String
  category        EventBudgetCategory
  item            String
  description     String?
  supplier        String?
  /// Dados do fornecedor, preenchidos ao lançar o realizado (opcionais —
  /// uma linha de previsão por categoria criada na abertura do evento não
  /// tem fornecedor ainda).
  supplierCnpj    String?
  supplierContact String?
  supplierPhone   String?
  quantity        Float?
  unitValue       Float?
  nfUrl           String?
  paymentMethod   String?
  status          String?
  /// Nulo quando a linha nasce como lançamento avulso de "realizado", sem
  /// previsão prévia por categoria.
  plannedValue    Float?
  actualValue     Float?
  createdAt       DateTime            @default(now())

  event    Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments EventBudgetLinePayment[]
}

/// Uma parcela (ou o pagamento único, à vista) de um item de orçamento.
/// Fica "agendada" com valor + data prevista; só quando marcada como paga
/// é que gera automaticamente uma CashMovement vinculada ao evento — assim
/// o Caixa nunca mostra dinheiro que ainda não saiu de fato.
model EventBudgetLinePayment {
  id             String    @id @default(cuid())
  budgetLineId   String
  dueDate        DateTime
  amount         Float
  paid           Boolean   @default(false)
  paidDate       DateTime?
  cashMovementId String?   @unique
  createdAt      DateTime  @default(now())

  budgetLine   EventBudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  cashMovement CashMovement?   @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
}

model EventSponsor {
  id            String        @id @default(cuid())
  eventId       String
  name          String
  contractValue Float
  status        SponsorStatus @default(negociacao)
  notes         String?
  createdAt     DateTime      @default(now())

  event    Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments EventSponsorPayment[]
}

model EventSponsorPayment {
  id        String    @id @default(cuid())
  sponsorId String
  dueDate   DateTime
  amount    Float
  paid      Boolean   @default(false)
  paidDate  DateTime?

  sponsor EventSponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Patrocínios (Igor/Operações): cadastro único de patrocinadores, só criado
// aqui — Eventos apenas exibe (ver Event.sponsors). Cada ficha é um evento
// (patrocínio recorrente vira uma ficha nova a cada evento/ano).
// ---------------------------------------------------------------------------

model Sponsor {
  id                  String               @id @default(cuid())
  name                String
  cnpj                String
  contactName         String
  contactPhone        String
  totalValue          Float
  paymentPlan         SponsorPaymentPlan
  paymentMethod       SponsorPaymentMethod
  paymentLink         String?
  paymentProofUrl     String?
  hasStageTime        Boolean              @default(false)
  stageTimeMinutes    Int?
  eventId             String?
  /// Patrocínio anual/recorrente sem um Event específico vinculado (ou além
  /// dele) — sinalizado aqui, com o Event ainda podendo apontar a edição
  /// mais próxima quando existir uma.
  isAnnual            Boolean              @default(false)
  tier                SponsorTier
  status              SponsorDealStatus    @default(em_negociacao)
  statusOther         String?
  /// Campos de perfil, exibidos aqui e na aba "Patrocínio" (só leitura) do
  /// evento vinculado.
  nfUrl               String?
  presentationUrl     String?
  /// Upload direto do arquivo de apresentação (PDF/PPT/PPTX), alternativa ao
  /// link em presentationUrl — os dois podem coexistir.
  presentationFileUrl String?
  logoUrl             String?
  videoUrl            String?
  /// Upload direto do arquivo de vídeo, alternativa ao link em videoUrl.
  videoFileUrl        String?
  activation          String?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  event        Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User                 @relation("SponsorCreatedBy", fields: [createdById], references: [id])
  installments SponsorInstallment[]
  interactions SponsorInteraction[]
  leadSales    SponsorLeadSale[]
  tasks        Task[]

  @@index([eventId])
}

/// Parcela de um contrato de patrocínio, quando paymentPlan = parcelado.
model SponsorInstallment {
  id        String    @id @default(cuid())
  sponsorId String
  number    Int
  amount    Float
  dueDate   DateTime
  paid      Boolean   @default(false)
  paidDate  DateTime?

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
}

/// Histórico de interações com o patrocinador — log, mesmo padrão de
/// CustomerInteraction.
model SponsorInteraction {
  id        String   @id @default(cuid())
  sponsorId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  author  User    @relation("SponsorInteractionAuthor", fields: [authorId], references: [id])

  @@index([sponsorId])
}

/// Venda originada de um lead do patrocinador — visão de ROI do patrocínio.
model SponsorLeadSale {
  id          String    @id @default(cuid())
  sponsorId   String
  description String?
  value       Float
  saleDate    DateTime?
  createdAt   DateTime  @default(now())

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
}

model EventAttendee {
  id                String              @id @default(cuid())
  eventId           String
  name              String
  gender            String?
  empresa           String?
  category          AttendeeCategory
  /// "Gold", "VIP" ou null (N/A — não se aplica, ex.: equipe interna)
  ticketType        String?
  email             String?
  phone             String?
  cpfRg             String?
  /// Faixa de faturamento da empresa do confirmado (texto livre, ex.: "Acima
  /// de 1 milhão por mês") — coletado no formulário de inscrição.
  revenueRange      String?
  /// Segmento/indústria da marca (texto livre, mesmo padrão de revenueRange).
  segmento          String?
  instagram         String?
  /// Instagram da pessoa física (o campo `instagram` acima é o da marca).
  instagramPersonal String?
  /// Sinaliza se o confirmado deu okay pra participar de uma dinâmica do
  /// evento (Plano Perfeito, Shark Tank, ou outra — texto livre em
  /// dynamicOther quando "outro").
  dynamicChoice     EventDynamicChoice?
  dynamicOther      String?
  confirmed         Boolean             @default(true)
  checkedIn         Boolean             @default(false)
  npsScore          Int?
  /// Pessoa focal do time comercial/CS que deve necessariamente falar com
  /// esse confirmado — não significa exclusividade de fechamento.
  focalPerson       String?
  inWhatsappGroup   Boolean             @default(false)
  /// Marca esse confirmado pra ir automaticamente na lista de convidados do
  /// Jantar da Imersão (ver EventDinnerGuest.attendeeId) — desmarcar remove
  /// o convidado correspondente de lá.
  inDinner          Boolean             @default(false)
  /// Link opcional para o mentorado real (Customer), quando o confirmado é
  /// alguém da carteira de CS — evita recadastrar presença/NPS em duplicado.
  customerId        String?
  /// Quem indicou essa marca — selecionado da lista de confirmados do
  /// mesmo evento. Uma mesma pessoa pode indicar mais de uma marca (não é
  /// @unique). Mutuamente exclusivo com os campos referrerName/Empresa/
  /// Whatsapp abaixo (usados quando a indicação é de alguém "outros", fora
  /// da lista de confirmados).
  referrerAttendeeId String?
  referrerName       String?
  referrerEmpresa    String?
  referrerWhatsapp   String?
  createdAt         DateTime            @default(now())

  event            Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer         Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  referrerAttendee EventAttendee?             @relation("AttendeeReferral", fields: [referrerAttendeeId], references: [id], onDelete: SetNull)
  referrals        EventAttendee[]            @relation("AttendeeReferral")
  checkins         EventAttendeeCheckin[]
  sales            EventAttendeeSale[]
  negotiations     EventAttendeeNegotiation[]
  dinnerGuest      EventDinnerGuest?

  @@index([referrerAttendeeId])
}

/// Venda registrada pra um confirmado do evento (curso/mentoria vendido no
/// contexto do evento) — mirror simplificado de SponsorLeadSale, com
/// parcelamento e vendedor.
model EventAttendeeSale {
  id                 String                    @id @default(cuid())
  attendeeId         String
  /// Programa vendido (texto livre — ver PRODUCTS em src/lib/products.ts).
  program            String
  /// Preenchido só quando program = "Outros".
  programOther       String?
  value              Float
  paymentPlan        SponsorPaymentPlan
  installmentCount   Int?
  paymentMethod      AttendeeSalePaymentMethod
  /// Preenchido só quando paymentMethod = outro.
  paymentMethodOther String?
  notes              String?
  saleDate           DateTime
  sellerId           String?
  createdAt          DateTime                  @default(now())

  attendee     EventAttendee                  @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  seller       User?                          @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  installments EventAttendeeSaleInstallment[]

  @@index([attendeeId])
}

/// Data de pagamento acordada por parcela, quando paymentPlan = parcelado.
model EventAttendeeSaleInstallment {
  id      String   @id @default(cuid())
  saleId  String
  number  Int
  dueDate DateTime
  /// Nullable pra não quebrar parcelas já lançadas antes desse campo existir.
  amount  Float?

  sale EventAttendeeSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model EventAttendeeCheckin {
  id         String   @id @default(cuid())
  attendeeId String
  date       DateTime
  present    Boolean  @default(true)

  attendee EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([attendeeId, date])
}

model EventNote {
  id        String   @id @default(cuid())
  eventId   String
  authorId  String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User  @relation("EventNoteAuthor", fields: [authorId], references: [id])
}

/// Lista de convidados do jantar da imersão.
model EventDinnerGuest {
  id         String   @id @default(cuid())
  eventId    String
  name       String
  category   String?
  empresa    String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  /// Preenchido quando esse convidado veio do checkbox "Jantar" de um
  /// EventAttendee — usado pra manter os dois em sincronia.
  attendeeId String?  @unique

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee EventAttendee? @relation(fields: [attendeeId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

/// Fluxo de comunicação com o grupo do evento (WhatsApp etc.) — o quê, quando
/// e com que objetivo, com a arte anexada ou linkada.
model EventCommsItem {
  id        String      @id @default(cuid())
  eventId   String
  date      DateTime
  time      String?
  artUrl    String?
  artLink   String?
  message   String
  objective String?
  status    CommsStatus @default(planejado)
  createdAt DateTime    @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// Checklist de entrega de foto/vídeo do evento — cada item criado já é o
/// "planejado"; marcar `done` é o "realizado".
// ---------------------------------------------------------------------------
// Financeiro (William + sócios): posição de caixa, DRE, contas a pagar/receber.
// Acesso é protegido por um segundo fator (senha do módulo) além do papel.
// ---------------------------------------------------------------------------

model CashAccount {
  id           String   @id @default(cuid())
  name         String
  balance      Float
  snapshotDate DateTime
}

model CashMovement {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  amount      Float
  /// Vínculo opcional a um evento — permite que despesas/receitas de um
  /// evento específico apareçam tanto no Financeiro quanto na página do
  /// próprio evento, sem duplicar o lançamento.
  eventId     String?
  createdAt   DateTime @default(now())

  event         Event?                  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  budgetPayment EventBudgetLinePayment?
}

/// Uma linha do DRE (ex.: "Club", "Impostos", "Pró-labore") — sempre uma
/// categoria-folha; os totais de Receita/Despesa/Resultado são somados a
/// partir destas linhas, nunca guardados separadamente.
model FinanceCategory {
  id    String              @id @default(cuid())
  name  String
  kind  FinanceCategoryKind
  order Int                 @default(0)

  entries FinanceEntry[]
}

model FinanceEntry {
  id         String @id @default(cuid())
  categoryId String
  /// "YYYY-MM"
  periodKey  String
  realizado  Float?
  previsto   Float?

  category FinanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, periodKey])
}

model Payable {
  id             String    @id @default(cuid())
  fornecedor     String
  descricao      String
  categoria      String
  centroCusto    String?
  competencia    String
  vencimento     DateTime
  pagamento      DateTime?
  valorPrevisto  Float
  valorRealizado Float?
  formaPagamento String?
  contaBancaria  String?
  responsavelId  String?
  observacoes    String?
  cancelled      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  responsavel User? @relation("PayableResponsible", fields: [responsavelId], references: [id])
}

model Receivable {
  id             String    @id @default(cuid())
  cliente        String
  empresa        String?
  produto        String?
  descricao      String
  categoria      String
  valor          Float
  valorRecebido  Float     @default(0)
  vencimento     DateTime
  dataPrevista   DateTime?
  dataEfetiva    DateTime?
  formaPagamento String?
  contaBancaria  String?
  responsavelId  String?
  observacoes    String?
  cancelled      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  responsavel User? @relation("ReceivableResponsible", fields: [responsavelId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  userId     String
  at         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// RH: one-on-ones mensais, avaliação trimestral e avaliação anual (dezembro).
// Fluxo em duas etapas por linha: primeiro o liderado responde a
// autoavaliação (campos self*), só depois o líder formaliza sua visão
// (rating/highlights/improvements/actionItems/notes) — nunca ao mesmo tempo.
// Acesso: admin/sócios veem tudo; um líder vê sua própria equipe e seus
// próprios encontros como avaliado (ver canViewRhFor em lib/permissions).
// ---------------------------------------------------------------------------

model RhReview {
  id          String       @id @default(cuid())
  type        RhReviewType
  subjectId   String
  evaluatorId String
  date        DateTime
  createdAt   DateTime     @default(now())

  // Autoavaliação do liderado — preenchida primeiro, pelo próprio subject.
  // Campos legados (pré-perguntas-por-tipo) — mantidos só pra exibir reviews
  // antigas; novas reviews de qualquer tipo (incl. one_on_one) gravam em
  // selfAnswers, com as chaves de RH_QUESTIONS_BY_TYPE (ver lib/rh.ts).
  selfClassification       RhClassification?
  selfClassificationReason String?
  selfWorkLifeBalance      String?
  selfContributionScore    Int?
  selfContributionReason   String?
  selfFeedbackToLeader     String?
  selfHighlights           String?
  selfImprovements         String?
  selfAnswers              Json?
  selfSubmittedAt          DateTime?

  // Formalização do líder — só faz sentido depois da autoavaliação existir.
  // leaderComments espelha as mesmas chaves de selfAnswers — um comentário
  // do líder por pergunta respondida, como pedido pelo negócio.
  leaderClassification        RhClassification?
  leaderClassificationComment String?
  rating                      Int?
  highlights                  String?
  improvements                String?
  actionItems                 String?
  notes                       String?
  leaderComments              Json?
  leaderSubmittedAt           DateTime?

  // Só usado em avaliações anuais — preenchido pelo líder junto da
  // formalização, não pelo liderado.
  leaderSalaryHistory    String?
  leaderPostReviewSalary Float?
  leaderExceptionalBonus Float?
  leaderRoleChanged      Boolean?
  leaderNextYearRole     String?

  subject   User @relation("RhReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  evaluator User @relation("RhReviewEvaluator", fields: [evaluatorId], references: [id])

  @@index([subjectId])
  @@index([evaluatorId])
}

/// Cargo e salário atual de cada colaborador — visível só por admin, pelo
/// líder da área da pessoa (nunca de outras áreas) e por William
/// (Financeiro tem acesso total, ver SALARY_FULL_ACCESS_EMAILS em
/// lib/permissions.ts). Nunca visível pro próprio colaborador comum.
model SalaryRecord {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// Nome completo formal, pra registro de RH — User.name pode ser só o
  /// primeiro nome (usado em todo o resto do app) e não deve mudar por
  /// causa desta tela.
  fullName  String
  cargo     String
  /// Rótulo livre pra exibição (ex.: "Eventos e Social", "C-Level") — o
  /// controle de acesso usa as Memberships reais do usuário, não este texto.
  areaLabel String
  salary    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Conhecimento — Calendário de treinamentos: um encontro por mês (2ª
// sexta-feira), com confirmação de presença, NPS, link do Meet e materiais
// complementares.
// ---------------------------------------------------------------------------

model Training {
  id           String   @id @default(cuid())
  theme        String
  description  String
  date         DateTime
  meetLink     String?
  nps          Float?
  npsResponses Int?
  createdAt    DateTime @default(now())

  attendees TrainingAttendee[]
  materials TrainingMaterial[]
}

model TrainingAttendee {
  id          String   @id @default(cuid())
  trainingId  String
  userId      String
  confirmedAt DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
}

/// Vídeo, podcast, artigo etc. complementando o tema do treinamento — mesma
/// ideia de tipos da Biblioteca (ver lib/library.ts).
model TrainingMaterial {
  id         String   @id @default(cuid())
  trainingId String
  title      String
  type       String
  url        String
  createdAt  DateTime @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Social — espelha a estrutura real do time no Notion (perfis geridos,
// podcast, CRM de social selling, calendário de conteúdo). Nenhum dado
// numérico é inventado: números vêm de fora (Reportei, planilha de métricas,
// Comercial) e são linkados ou consultados ao vivo, nunca duplicados aqui.
// ---------------------------------------------------------------------------

/// Um perfil gerido pelo time de Social (sócio tratado como influencer, ou o
/// institucional da BL). contentScope é o "combinado" de escopo de postagem.
model SocialProfile {
  id              String  @id @default(cuid())
  name            String
  personId        String?
  isInstitutional Boolean @default(false)
  reporteiUrl     String?
  contentScope    String?
  order           Int     @default(0)

  person               User?                    @relation(fields: [personId], references: [id])
  contentCalendarPosts ContentCalendarPost[]
  reporteiMetrics      SocialReporteiMetric[]
  reporteiInsights     SocialReporteiInsight[]
  reports              SocialProfileReport[]
  reporteiPosts        SocialReporteiPost[]
  followerSnapshots    SocialFollowerSnapshot[]
  weekPlanCells        ContentWeekPlanCell[]
}

/// Célula de referência da tabela semanal de conteúdo (subárea "Conteúdo") —
/// um planejamento-modelo por perfil x dia da semana (1=segunda..7=domingo),
/// não datado (o Calendário é quem tem posts com data real). Texto livre com
/// marcação leve: linhas iniciadas por 2+ espaços viram sub-item, **negrito**
/// e *itálico* são respeitados na renderização.
model ContentWeekPlanCell {
  id        String   @id @default(cuid())
  profileId String
  weekday   Int
  content   String
  updatedAt DateTime @updatedAt

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, weekday])
}

/// Relatório periódico anexado a um perfil (upload de arquivo ou link).
model SocialProfileReport {
  id             String    @id @default(cuid())
  profileId      String
  title          String
  /// Mês de referência do relatório, "YYYY-MM".
  reportMonth    String
  dueDate        DateTime?
  /// Período efetivamente analisado no relatório (texto livre, ex.: "01/08 a
  /// 31/08" ou "últimos 30 dias") — pode diferir do mês de referência.
  periodAnalyzed String?
  /// Principais pontos de atenção, aprendizados e recomendações do período.
  summary        String?
  notes          String?
  createdById    String
  createdAt      DateTime  @default(now())

  profile     SocialProfile                   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy   User                            @relation(fields: [createdById], references: [id])
  attachments SocialProfileReportAttachment[]

  @@index([profileId])
}

/// Link ou arquivo anexado a um relatório — pode ter mais de um.
model SocialProfileReportAttachment {
  id        String   @id @default(cuid())
  reportId  String
  label     String
  url       String
  createdAt DateTime @default(now())

  report SocialProfileReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

/// Uma linha por card de métrica extraído do dashboard público do Reportei —
/// esquema genérico de propósito, porque cada perfil pode ter um conjunto
/// diferente de cards e o Reportei pode adicionar/remover cards a qualquer
/// momento. "Atualizar" apaga e recria todas as linhas do perfil.
model SocialReporteiMetric {
  id            String   @id @default(cuid())
  profileId     String
  title         String
  periodLabel   String?
  value         String
  deltaLabel    String?
  previousLabel String?
  fetchedAt     DateTime @default(now())

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Pontos de atenção calculados a partir do último pull de métricas —
/// recalculado a cada "Atualizar", nunca preenchido manualmente.
model SocialReporteiInsight {
  id        String   @id @default(cuid())
  profileId String
  severity  String
  message   String
  fetchedAt DateTime @default(now())

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Uma linha por post da tabela "Dados orgânicos de postagens" do Reportei —
/// tem data real do post (postedAt), então dá pra montar histórico mês a mês
/// sem depender só de quantas vezes alguém clicou em "Atualizar". Dedupe por
/// (profileId, postLabel, postedAt) já que o Reportei reexpõe os mesmos
/// posts em janelas de datas sobrepostas a cada novo pull.
model SocialReporteiPost {
  id                String    @id @default(cuid())
  profileId         String
  postLabel         String
  type              String?
  alcance           Float?
  visualizacoes     Float?
  curtidas          Float?
  comentarios       Float?
  salvamentos       Float?
  compartilhamentos Float?
  postedAt          DateTime?
  fetchedAt         DateTime  @default(now())

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, postLabel, postedAt])
  @@index([profileId])
}

/// Total de seguidores da conta, preenchido manualmente mês a mês — o
/// Reportei não expõe um card único com esse total (só variação/crescimento
/// e ranking por cidade), então usamos isso como denominador do engajamento
/// por seguidores até o relatório trazer esse dado de forma limpa.
model SocialFollowerSnapshot {
  id        String   @id @default(cuid())
  profileId String
  /// "YYYY-MM"
  monthKey  String
  count     Int
  updatedAt DateTime @updatedAt

  profile SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, monthKey])
}

model PodcastEpisode {
  id                     String        @id @default(cuid())
  /// Nulo pra convidados ainda no funil (leads em conversa/reagendando)
  /// que não têm um número de episódio atribuído ainda.
  episodeNumber          Int?
  guestName              String
  guestBrand             String?
  recordingDate          DateTime?
  guestBrandInstagram    String?
  guestPersonalInstagram String?
  materialDeadline       DateTime?
  postDate               DateTime?
  rawMaterialUrl         String?
  editedMaterialUrl      String?
  status                 PodcastStatus @default(entrevista_marcada)
  source                 PodcastSource
  /// Preenchido só quando source = outro.
  sourceOther            String?
  createdAt              DateTime      @default(now())

  /// Responsável por cada etapa — gravação, material e postagem. *Other é
  /// preenchido só quando o responsável não é alguém do time (id = null).
  recordingResponsibleId    String?
  recordingResponsibleOther String?
  materialResponsibleId     String?
  materialResponsibleOther  String?
  postResponsibleId         String?
  postResponsibleOther      String?
  recordingResponsible      User?   @relation("PodcastRecordingResponsible", fields: [recordingResponsibleId], references: [id])
  materialResponsible       User?   @relation("PodcastMaterialResponsible", fields: [materialResponsibleId], references: [id])
  postResponsible           User?   @relation("PodcastPostResponsible", fields: [postResponsibleId], references: [id])

  /// Transcrição do episódio e disparo da copy nos grupos.
  transcript                 String?
  dispatchCopy               String?
  dispatchDate               DateTime?
  dispatchResponsibleId      String?
  dispatchResponsibleOther   String?
  dispatchResponsible        User?        @relation("PodcastDispatchResponsible", fields: [dispatchResponsibleId], references: [id])
  dispatchStatus              CommsStatus?
}

/// Funil de Social Selling — só o pipeline (lead → reunião → status). O
/// valor de venda fechado NÃO mora aqui: vem ao vivo do Comercial (ver
/// computeCommercialSnapshot em lib/social.ts) para não duplicar a fonte
/// de verdade da receita.
model SocialSellingLead {
  id            String           @id @default(cuid())
  leadName      String
  companyName   String?
  contactPerson String?
  salespersonId String?
  meetingDate   DateTime?
  status        SocialLeadStatus @default(sem_resposta)
  notes         String?
  createdAt     DateTime         @default(now())

  /// Venda fechada por esse lead — texto livre (ver SOCIAL_SALE_PRODUCTS em
  /// src/lib/social.ts: Plataforma EAD, Axoly Brand, Cadeiras VIP Imersão,
  /// Cadeiras Gold, Club, Tração, Master). Preenchido só quando o lead
  /// converte; alimenta Receita/ticket médio/vendas por produto do CRM.
  saleProduct String?
  saleValue   Float?
  saleDate    DateTime?

  salesperson User? @relation(fields: [salespersonId], references: [id])
}

/// Calendário real de postagens (o que efetivamente vai/foi ao ar), separado
/// do texto de metodologia semanal (guardado como referência em lib/social.ts
/// — preservado literal para não arriscar reatribuir conteúdo ao dia errado).
model ContentCalendarPost {
  id          String            @id @default(cuid())
  date        DateTime
  profileId   String
  format      ContentFormat
  theme       String
  status      ContentPostStatus @default(planejado)
  notes       String?
  createdById String
  createdAt   DateTime          @default(now())

  profile   SocialProfile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy User                      @relation(fields: [createdById], references: [id])
  links     ContentCalendarPostLink[]
  /// Tarefas reais do Workflow (mesma Task de sempre) abertas a partir do
  /// card estilo Asana do post — aparecem aqui E em Workflow, é a mesma linha.
  tasks     Task[]
}

/// Um link de referência (briefing, drive, roteiro...) anexado ao card
/// estilo Asana do post — não é o link publicado, é material de apoio.
model ContentCalendarPostLink {
  id        String   @id @default(cuid())
  postId    String
  label     String
  url       String
  createdAt DateTime @default(now())

  post ContentCalendarPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// ---------------------------------------------------------------------------
// Customer Success — Customer é a fonte única de verdade do departamento.
// MRR/ARR/ARPU/LTV/churn/health score são todos CALCULADOS ao vivo (ver
// lib/cs.ts), nunca armazenados aqui, para nunca dessincronizar da base.
// Eventos e tarefas não são duplicados: EventAttendee.customerId e
// Task.customerId linkam para a infraestrutura que já existe.
// ---------------------------------------------------------------------------

model Customer {
  id            String         @id @default(cuid())
  name          String
  company       String?
  /// String livre (Club, Tração, ...) — mesmo padrão de lib/products.ts,
  /// permite adicionar produtos sem migração.
  product       String
  csId          String
  entryDate     DateTime
  startDate     DateTime?
  endDate       DateTime?
  renewalDate   DateTime?
  status        CustomerStatus @default(ativo)
  /// Receita mensal recorrente ativa deste cliente — insumo do MRR/ARR/ARPU.
  mrr           Float?
  contractValue Float?
  lastContactAt DateTime?
  nextContactAt DateTime?
  notes         String?
  contractUrl   String?
  otherDocsUrl  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  cs           User                  @relation("CustomerCS", fields: [csId], references: [id])
  interactions CustomerInteraction[]
  renewals     CustomerRenewal[]
  experiences  CustomerExperience[]
  attendances  EventAttendee[]
  tasks        Task[]
  meetings     CustomerMeeting[]

  @@index([csId])
  @@index([product])
}

/// Log de toques do CS com o cliente — interação, problema, sucesso ou
/// observação. Base do "último contato" e de parte do Health Score.
model CustomerInteraction {
  id         String                  @id @default(cuid())
  customerId String
  kind       CustomerInteractionKind
  content    String
  authorId   String
  createdAt  DateTime                @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("CustomerInteractionAuthor", fields: [authorId], references: [id])

  @@index([customerId])
}

/// Um ciclo de renovação — dá granularidade mensal real para a visão anual
/// de "disponível x realizado" (Aba 1) sem duplicar valores no Customer.
model CustomerRenewal {
  id            String        @id @default(cuid())
  customerId    String
  dueDate       DateTime
  plannedValue  Float
  realizedValue Float?
  realizedDate  DateTime?
  status        RenewalStatus @default(disponivel)
  notes         String?
  createdAt     DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([dueDate])
}

/// Experiência individual do mentorado num evento — alimenta eNPS, Health
/// Score e o fluxo Convidado → Confirmado → Presente → Experiência → Follow-up.
model CustomerExperience {
  id              String    @id @default(cuid())
  customerId      String
  eventId         String
  score           Int?
  feedback        String?
  positives       String?
  negatives       String?
  opportunities   String?
  needsFollowUp   Boolean   @default(false)
  followUpOwnerId String?
  followUpDate    DateTime?
  followUpDone    Boolean   @default(false)
  createdAt       DateTime  @default(now())

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  followUpOwner User?    @relation("ExperienceFollowUpOwner", fields: [followUpOwnerId], references: [id])

  @@index([customerId])
  @@index([eventId])
}

/// Encontro individual de mentoria (não confundir com os eventos/experiências
/// coletivas de endomarketing, já cobertos por CustomerExperience). Club tem
/// 8 encontros individuais no ciclo, Tração tem 2 — ver MEETING_TARGET_BY_PRODUCT
/// em lib/cs.ts. "coletivo" registra encontros em grupo à parte da meta fixa.
model CustomerMeeting {
  id           String              @id @default(cuid())
  customerId   String
  type         CustomerMeetingType @default(individual)
  /// Nome do encontro (ex.: "Diagnóstico", "Mentoria 3") — Club segue
  /// Diagnóstico + Plano de Ação + Mentoria 3-8 (8 encontros); Tração segue
  /// Diagnóstico + Plano de Ação + Mentoria 1-3 (5 encontros individuais).
  label        String?
  sequence     Int?
  date         DateTime
  transcript   String?
  recordingUrl String?
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CustomerMeetingAuthor", fields: [createdById], references: [id])

  @@index([customerId])
}

/// Ação de endomarketing planejada pelo time de CS para os mentorados em
/// geral (não presa a um cliente específico) — o quê, como, onde, link e
/// materiais. Complementa o calendário de Eventos e o "Calendário de ações"
/// importado (ver CsActionCalendarItem).
model CsAction {
  id           String   @id @default(cuid())
  title        String
  description  String?
  location     String?
  link         String?
  materialsUrl String?
  date         DateTime
  createdById  String
  createdAt    DateTime @default(now())

  createdBy User @relation("CsActionAuthor", fields: [createdById], references: [id])
}

/// Item importado do "Calendário de ações" real do time (planilha Google
/// Sheets) — referência somente-leitura, não editável pelo app.
model CsActionCalendarItem {
  id          String  @id @default(cuid())
  month       String
  date        String?
  time        String?
  eventName   String
  responsible String?
  audience    String?
  status      String?
  notes       String?
}

/// Estrutura real de Tráfego + funis comerciais (aquisição, funis, social
/// selling, SDR, closers, renovação) importada da planilha de performance
/// do time. Valores guardados como texto (R$, %, contagem, fórmulas com
/// erro na origem) porque a planilha mistura formatos — não normalizamos
/// para não inventar um dado que a fonte não garante.
model PerformanceSection {
  id      String              @id @default(cuid())
  name    String
  order   Int
  metrics PerformanceMetric[]
}

model PerformanceMetric {
  id        String  @id @default(cuid())
  sectionId String
  label     String
  target    String?
  realized  String?
  order     Int

  section PerformanceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Tráfego — dados reais puxados do Windsor.ai (Facebook Ads + GoHighLevel).
// Não tem Area própria (Tráfego vive junto do Comercial, ver nav.ts) — a
// permissão de leitura/edição reaproveita canViewArea/canEditAreaKpis(user,
// "comercial"). Uma linha por dia x campanha (ou dia x anúncio); agregação
// por período é feita em memória na hora de renderizar, nunca pré-calculada.
// ---------------------------------------------------------------------------

/// Categoria de investimento, derivada automaticamente do nome/objetivo da
/// campanha no Facebook (ver lib/traffic.ts classifyCampaign) — pode ser
/// sobrescrita campanha a campanha via TrafficCampaignCategoryOverride.
enum TrafficCategory {
  aquisicao
  eventos
  distribuicao
}

model TrafficCampaignMetric {
  id             String          @id @default(cuid())
  date           DateTime
  accountId      String
  accountName    String
  campaignId     String
  campaignName   String
  objective      String?
  category       TrafficCategory
  spend          Float
  leads          Float
  fetchedAt      DateTime        @default(now())

  @@unique([campaignId, date])
  @@index([date])
  @@index([category])
}

/// Override manual de categoria por campanha — checado antes da
/// classificação automática a cada "Atualizar".
model TrafficCampaignCategoryOverride {
  campaignId String          @id
  category   TrafficCategory
}

model TrafficAdMetric {
  id           String   @id @default(cuid())
  date         DateTime
  accountId    String
  campaignId   String
  campaignName String
  adId         String
  adName       String
  spend        Float
  leads        Float
  fetchedAt    DateTime @default(now())

  @@unique([adId, date])
  @@index([date])
}

/// Um contato do GoHighLevel com a tag "mql" — validado manualmente pelo
/// time Comercial (não há atribuição de campanha confiável hoje, ver
/// discussão na sessão que criou este modelo). dateAdded é a data de
/// criação do contato no CRM, usada para filtrar por período.
model TrafficMqlLead {
  id         String   @id @default(cuid())
  externalId String   @unique
  contactName String?
  dateAdded  DateTime
  fetchedAt  DateTime @default(now())

  @@index([dateAdded])
}

/// Oportunidade do GoHighLevel que avançou além do primeiro estágio do seu
/// funil — "o comercial avança nas tratativas" (confirmado pelo usuário na
/// sessão que criou este modelo). isAdvanced é calculado no refresh a partir
/// da posição do estágio dentro do pipeline (position > 0); só as
/// avançadas contam como SQL — as demais ficam de fora do funil aqui.
model TrafficSqlLead {
  id         String   @id @default(cuid())
  externalId String   @unique
  pipelineId String
  stageId    String
  status     String
  isAdvanced Boolean
  createdAt  DateTime
  fetchedAt  DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Comercial — faturamento, pipeline e reuniões reais, extraídos do
// GoHighLevel (Opportunities/Pipelines/Users) e do Calendly (reuniões +
// no-show). Não tem Area própria de verdade pro CRM em si — reaproveita
// canViewArea/canEditAreaKpis(user, "comercial"), mesmo padrão de Tráfego.
// ---------------------------------------------------------------------------

enum GhlOpportunityStatus {
  open
  won
  lost
}

/// Canal de origem derivado do pipeline do GoHighLevel — não há campo de
/// atribuição de canal confiável no CRM (contact_source e opportunity_source
/// estão vazios em ~98% das linhas reais, verificado na sessão que criou
/// este modelo). Indicação, Referidos e Recuperação Própria não têm pipeline
/// correspondente hoje, então não aparecem — mostrar 0 seria inventar dado.
enum LeadChannel {
  trafego
  social_selling
  sdr
  eventos
  outros
}

model GhlOpportunity {
  id              String               @id @default(cuid())
  externalId      String               @unique
  name            String
  monetaryValue   Float
  status          GhlOpportunityStatus
  pipelineId      String
  pipelineName    String
  stageId         String
  stageName       String?
  channel         LeadChannel
  /// "Tração" | "Club" | "Master" | "Evento" | null — parseado do nome da
  /// oportunidade (sufixo "- CLUB"/"- TRAÇÃO"/"- MASTER") quando presente;
  /// nem toda oportunidade tem o sufixo, então fica null em parte dos casos.
  product         String?
  assignedToEmail String?
  createdAt       DateTime
  /// Data da última mudança de status — usada como proxy de "data do
  /// fechamento" pra bucketizar faturamento por mês quando status = won.
  wonAt           DateTime?
  fetchedAt       DateTime             @default(now())

  @@index([createdAt])
  @@index([wonAt])
  @@index([status])
  @@index([assignedToEmail])
  @@index([channel])
}

model CalendlyMeeting {
  id            String   @id @default(cuid())
  externalId    String   @unique
  eventTypeName String
  assigneeEmail String?
  startTime     DateTime
  status        String
  noShow        Boolean  @default(false)
  utmSource     String?
  fetchedAt     DateTime @default(now())

  @@index([startTime])
  @@index([assigneeEmail])
}

/// Histórico real de patrocínios (planilha do time) — cada linha é uma
/// competência mensal de um contrato de patrocínio. eventId é opcional:
/// só é preenchido quando dá para casar com segurança a um Event real
/// (ver seed) — nunca inventamos o vínculo.
model Sponsorship {
  id            String    @id @default(cuid())
  sponsorName   String
  category      String?
  paymentMethod String?
  contractTerm  String?
  competencia   String?
  dueDate       DateTime?
  plannedValue  Float?
  paidDate      DateTime?
  paidValue     Float?
  status        String?
  cashMonth     String?
  notes         String?
  eventId       String?

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

// -----------------------------------------------------------------------
// CRM (Comercial) — Fase 1: esqueleto/visualização. Model novo e
// independente do GhlOpportunity (que é só espelho read-only do sync diário
// do Windsor/GoHighLevel) — aqui o time cria e move leads de verdade.
// Sincronização automática com o GoHighLevel fica para uma fase futura.
// -----------------------------------------------------------------------

enum LeadFunnel {
  eventos
  consultoria_gratuita
  plataformas
}

enum LeadOrigin {
  trafego
  indicacao
  organico
  email_marketing
  prospeccao_ativa
  recuperacao
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  instagram String?
  value     Float?
  origin    LeadOrigin
  funnel    LeadFunnel
  /// Chave da etapa dentro de FUNNEL_STAGES[funnel] (src/lib/crm.ts) — texto
  /// livre por design, mesmo padrão de PRODUCTS/TaskAttachment.kind, pra não
  /// exigir migration ao ajustar etapas.
  stageKey String
  /// Cross-funil, independente de origem — sinaliza lead desqualificado em
  /// qualquer funil (visão do SDR inclui todo lead marcado assim).
  disqualified Boolean  @default(false)
  assignedToId String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTo   User?             @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  interactions LeadInteraction[]
  attachments  LeadAttachment[]

  @@index([funnel])
  @@index([origin])
  @@index([assignedToId])
  @@index([disqualified])
}

model LeadInteraction {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation("LeadInteractionAuthor", fields: [authorId], references: [id])

  @@index([leadId])
}

model LeadAttachment {
  id        String   @id @default(cuid())
  leadId    String
  label     String
  url       String
  kind      String   @default("referencia")
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

// -----------------------------------------------------------------------
// Eventos — mapa comercial: entrega de mídia estruturada, negociação,
// produtos comercializados por evento, relatório de debriefing.
// -----------------------------------------------------------------------

/// Substitui o antigo EventMediaTask (checklist simples) e os campos de
/// texto livre Event.mediaScopePlanned/mediaScopeActual.
model EventMediaDeliverable {
  id        String @id @default(cuid())
  eventId   String
  title     String // O que precisa ser entregue
  objective String?
  trackingOwnerId  String? // Responsável pelo acompanhamento
  executionOwnerId String? // Responsável pela realização (time)
  /// Preenchido só quando o responsável pela realização é "Outros".
  executionOwnerOther String?
  plannedDate        DateTime?
  isQuantityDelivery  Boolean   @default(false)
  plannedQuantity     Int?
  deliveredQuantity   Int?
  notes               String?
  fileLabel           String?
  fileUrl             String?
  order               Int      @default(0)
  createdAt           DateTime @default(now())

  event          Event                              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  trackingOwner  User?                              @relation("MediaDeliverableTrackingOwner", fields: [trackingOwnerId], references: [id], onDelete: SetNull)
  executionOwner User?                              @relation("MediaDeliverableExecutionOwner", fields: [executionOwnerId], references: [id], onDelete: SetNull)
  realizations   EventMediaDeliverableRealization[]

  @@index([eventId])
}

/// Datas de realização — pode ser mais de um dia por entrega.
model EventMediaDeliverableRealization {
  id            String   @id @default(cuid())
  deliverableId String
  date          DateTime

  deliverable EventMediaDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

/// Negociação em andamento com um confirmado — separado de
/// EventAttendeeSale (venda já fechada), pra dar visibilidade de quem ainda
/// está em conversa vs quem já comprou.
model EventAttendeeNegotiation {
  id                String   @id @default(cuid())
  attendeeId        String
  sellerId          String?
  negotiationDate   DateTime
  value             Float?
  paymentConditions String?
  /// Informações importantes do lead (contexto de qualificação).
  leadInfo String?
  notes    String?
  createdAt DateTime @default(now())

  attendee EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  seller   User?         @relation("EventAttendeeNegotiationSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([attendeeId])
}

enum CommercialProductPaymentMethod {
  cartao_credito_avista
  cartao_credito_recorrencia
  boleto
  pix
  pix_recorrente
  outro
}

/// Catálogo de referência dos produtos comercializados NESTE evento — não
/// alimenta o dropdown de "programa" de venda/negociação (decisão do
/// usuário), é só informativo (preço, condições, escopo, deck).
model EventCommercialProduct {
  id                  String                          @id @default(cuid())
  eventId             String
  name                String
  value               Float
  minPaymentCondition String?
  maxPaymentCondition String?
  paymentMethod       CommercialProductPaymentMethod
  /// Preenchido só quando paymentMethod = outro.
  paymentMethodOther String?
  scope              String?
  deckUrl            String?
  createdAt          DateTime                        @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// Relatório de debriefing do evento — campo mais ao final do card do
/// evento; mais de um relatório pode ser anexado (ex.: um por área).
model EventDebriefReport {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  deliveryDate DateTime?
  summary      String?
  fileUrl      String?
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
